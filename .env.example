# Required local settings.
MEDIA_ROOT=/mnt/d/Media
MEDIA_ROOT_DOCKER=D:/Media
PUID=1000
PGID=1000
TZ=Asia/Ho_Chi_Minh
LOCAL_ADMIN_USER=admin
LOCAL_ADMIN_PASSWORD=media1234
HOST_CONTROLLER_TOKEN=replace-with-a-long-random-token
SUBTITLE_TOKEN_SECRET=replace-with-a-long-random-token
TV_DOWNLOAD_TOKEN_SECRET=replace-with-a-long-random-token
WSL_DISTRO=Ubuntu
WSL_PROJECT_DIR=

# Optional provider settings. Keep credentials only in your private .env.
OPENSUBTITLES_USERNAME=
OPENSUBTITLES_PASSWORD=
JELLYFIN_API_KEY=
YIFY_DIRECT_ENABLED=false
YIFY_DIRECT_BASE_URL=
YTS_MOVIE_API_URL=https://movies-api.accel.li
YTS_OFFICIAL_TV_URL=https://en.yts-official.com/
YTS_OFFICIAL_TV_ENABLED=true
SUBTITLE_AUTO_ENABLED=true
SUBTITLE_AUTO_INTERVAL_MS=21600000
SUBTITLE_AUTO_MAX_ITEMS=50
SUBTITLE_AUTO_CONCURRENCY=2
